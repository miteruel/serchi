# Copy this file to .env.local and fill in the values. See docs/DESPLIEGUE.md.

# SITE_URL: Recommended in production. Public address of the site, without a
# trailing slash (e.g. https://serchi.example.org). Used for absolute links in
# sitemap.xml and in the previews shown when a page is shared. If empty, the
# address of each request is used.
SITE_URL=""

# GEMINI_API_KEY: Optional. Enables the live discovery of new Esperanto sites
# with Gemini and Google Search (the "Add link" window). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# FORUM_MODERATOR_KEY: Set it on any public site. The moderators' key: the forum
# (pin, lock and delete for everyone), the course editor and the review of the
# recordings ask for it. Without it anyone moderates, and recording from the
# course editor or creating/removing synthetic voices is disabled.
FORUM_MODERATOR_KEY=""

# DOMAIN: Only for docker compose --profile https. Public domain name that
# Caddy gets an HTTPS certificate for (e.g. serchi.example.org).
DOMAIN=""
